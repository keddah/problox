#line 305 "/Engine/Private/Strata/StrataTree.ush"
void FStrataTree::UpdateAllBSDFWithBottomUpOperatorVisit_Weight(
	int BSDFIndex,
	int OpIndex,
	int PreviousIsInputA)
{


	const float Weight = saturate(this.Operators[OpIndex].Weight);
