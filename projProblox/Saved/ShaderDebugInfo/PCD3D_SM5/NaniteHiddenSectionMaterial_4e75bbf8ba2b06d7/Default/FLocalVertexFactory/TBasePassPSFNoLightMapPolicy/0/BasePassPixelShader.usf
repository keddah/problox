		Ret = 0.1f * float4(1.0f, 0.25f, 0.075f, 0) * In.EstimatedCost;
	}
	else
	{
		Ret = float4(In.TotalLight, 0);

		if (1 == 1 )
		{
			if (View_bCheckerboardSubsurfaceProfileRendering == 0)
			{
				
				Ret.a = In.ScatterableLightLuma;
			}
		}
		else if (1 == 2)
		{
			
			
			Ret.a = Luminance(In.ScatterableLight);
			
		}
	}

	return Ret;
}

