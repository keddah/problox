{
	float3 F0  =   GetF0F90RGB(InF0);
	float3 F90 =   GetF0F90RGB(InF90);

	  FBxDFEnergyTermsRGB Result;
	
	

	Result.W = View_bShadingEnergyConservation ? (1.0 + F0 * ((1 - E.x) / E.x)) : 1.0f;



	
	
	
	Result.E = Result.W * (E.x * F0 + E.y * (F90 - F0));
	return Result;
}

